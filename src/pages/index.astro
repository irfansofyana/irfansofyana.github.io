---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
---

<Layout title="Irfan Sofyana Putra">
  <Terminal />
</Layout>

<style>
  :global(.main-content) {
    height: 100vh;
    height: 100dvh;
    background: transparent;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    :global(.main-content) {
      padding: 0;
      align-items: center;
    }
  }
</style>
</Layout>