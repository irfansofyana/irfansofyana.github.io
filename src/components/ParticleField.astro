---
// Particle Field Background Component
// Creates a subtle animated particle field for depth and ambiance
---

<div id="particle-field" class="particle-field-container"></div>

<style>
  .particle-field-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    background: transparent;
    pointer-events: none;
    overflow: hidden;
  }
  
  .particle {
    position: absolute;
    background: #00ff00;
    border-radius: 50%;
    opacity: 0.1;
    animation: float linear infinite;
    box-shadow: 0 0 6px rgba(0, 255, 0, 0.3);
  }
  
  .particle.size-small {
    width: 2px;
    height: 2px;
  }
  
  .particle.size-medium {
    width: 3px;
    height: 3px;
    opacity: 0.15;
  }
  
  .particle.size-large {
    width: 4px;
    height: 4px;
    opacity: 0.08;
  }
  
  @keyframes float {
    from {
      transform: translateY(100vh) translateX(0);
    }
    to {
      transform: translateY(-10px) translateX(20px);
    }
  }

  /* Reduce or disable animation for users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .particle-field-container {
      display: none;
    }
    
    .particle {
      animation: none;
    }
  }
</style>

<script>
  class ParticleField {
    private container: HTMLElement;
    private particles: HTMLElement[] = [];
    private particleCount: number = 25;
    private isVisible: boolean = true;

    constructor(container: HTMLElement) {
      this.container = container;
      this.setupEventListeners();
      this.createParticles();
    }

    private setupEventListeners(): void {
      // Pause animation when tab is not visible
      document.addEventListener('visibilitychange', () => {
        this.isVisible = !document.hidden;
        this.toggleAnimations();
      });

      // Handle reduced motion preference changes
      const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      mediaQuery.addEventListener('change', (e) => {
        if (e.matches) {
          this.container.style.display = 'none';
        } else {
          this.container.style.display = 'block';
        }
      });

      // Clean up particles on window resize
      window.addEventListener('resize', () => {
        this.repositionParticles();
      });
    }

    private createParticles(): void {
      for (let i = 0; i < this.particleCount; i++) {
        const particle = document.createElement('div');
        particle.className = 'particle';
        
        // Random size
        const sizes = ['size-small', 'size-medium', 'size-large'];
        const randomSize = sizes[Math.floor(Math.random() * sizes.length)];
        particle.classList.add(randomSize);
        
        // Random starting position
        particle.style.left = Math.random() * 100 + '%';
        particle.style.animationDelay = Math.random() * 20 + 's';
        particle.style.animationDuration = (15 + Math.random() * 25) + 's';
        
        this.container.appendChild(particle);
        this.particles.push(particle);
      }
    }

    private repositionParticles(): void {
      this.particles.forEach(particle => {
        particle.style.left = Math.random() * 100 + '%';
      });
    }

    private toggleAnimations(): void {
      this.particles.forEach(particle => {
        if (this.isVisible) {
          particle.style.animationPlayState = 'running';
        } else {
          particle.style.animationPlayState = 'paused';
        }
      });
    }

    public destroy(): void {
      this.particles.forEach(particle => {
        particle.remove();
      });
      this.particles = [];
    }
  }

  // Initialize Particle Field when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('particle-field') as HTMLElement;
    if (container && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Check user preference from localStorage
      const effectsEnabled = localStorage.getItem('effects-enabled');
      
      // Default to enabled if no preference is stored
      if (effectsEnabled === null || effectsEnabled === 'true') {
        try {
          // Small delay to ensure page has loaded
          setTimeout(() => {
            new ParticleField(container);
          }, 1000);
        } catch (error) {
          console.warn('Particle Field initialization failed:', error);
        }
      } else {
        // Hide container if user has disabled effects
        container.style.display = 'none';
      }
    }
  });
</script>
