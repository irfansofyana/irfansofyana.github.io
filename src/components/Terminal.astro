---
// Import profile data from JSON file
import profileData from '../data/profile.json';

// Create a profile object from the imported data
const profile = profileData;

// Use the base path from the config
import baseConfig from '../../astro.config.mjs';

// Construct the full path for the profile picture
let profilePicturePath = profile.profile_picture;
if (baseConfig.base !== '/') {
  profilePicturePath = `${baseConfig.base}/${profile.profile_picture}`;
}
---

<script id="profile-data" type="application/json" set:html={JSON.stringify(profile)}></script>

<div class="terminal-container">
  <div class="terminal-header">
    <div class="terminal-controls">
      <div class="control close"></div>
      <div class="control minimize"></div>
      <div class="control maximize"></div>
    </div>
    <div class="terminal-title">terminal</div>
  </div>
  
  <div class="terminal-body">
    <div class="terminal-content" id="terminal-content">
      <!-- Welcome Message -->
      <div class="terminal-line">
        <span class="terminal-prompt">{profile.prompt}</span>
        <span class="terminal-command typing-animation">whoami</span>
      </div>
      
      <div class="terminal-output">
        <img 
          src={profilePicturePath} 
          alt="Profile Picture" 
          class="profile-picture" 
          onerror="this.style.display='none'; console.log('Profile picture failed to load:', this.src);"
          onload="console.log('Profile picture loaded successfully:', this.src);"
        />
        {profile.welcome_message && profile.welcome_message.trim() !== '' && (
          <div class="welcome-message">{profile.welcome_message}</div>
        )}
        <div class="name">{profile.name}</div>
        <div class="title">{profile.title}</div>
        <div class="bio">{profile.bio}</div>
        {profile.contact && profile.contact.show_in_welcome && (
          <div class="contact-info">
            <div class="contact-label">📧 Contact:</div>
            <a href={`mailto:${profile.contact.email}`} class="contact-email">{profile.contact.email}</a>
          </div>
        )}
      </div>

      <!-- Available Commands -->
      <div class="terminal-line">
        <span class="terminal-prompt">{profile.prompt}</span>
        <span class="terminal-command">help</span>
      </div>
      
      <div class="terminal-output">
        <div class="command-list">
          <div class="command-header">Available Commands:</div>
          {profile.social_links.map((link) => (
            <div class="command-item">
              <span class="command-name">{link.command}</span>
              <span class="command-description">{link.description}</span>
            </div>
          ))}
          <div class="command-item">
            <span class="command-name">about</span>
            <span class="command-description">Display detailed information about me</span>
          </div>
          <div class="command-item">
            <span class="command-name">skills</span>
            <span class="command-description">Show my technical skills</span>
          </div>
          <div class="command-item">
            <span class="command-name">clear</span>
            <span class="command-description">Clear terminal and restore welcome state</span>
          </div>
          <div class="command-item">
            <span class="command-name">whoami</span>
            <span class="command-description">Display user information</span>
          </div>
        </div>
      </div>

      <!-- Interactive Prompt -->
      <div class="terminal-line interactive-line" id="input-line">
        <span class="terminal-prompt">{profile.prompt}</span>
        <input 
          type="text" 
          id="terminal-input" 
          class="terminal-input" 
          autocomplete="off" 
          spellcheck="false"
          placeholder="Type a command..."
        />
        <span class="terminal-cursor">_</span>
      </div>
      
      <div class="footer-text">{profile.footer_text}</div>
    </div>
  </div>
</div>

<style>
  /* CSS Custom Properties for easy theme customization */
  :root {
    --glow-color: #00ff00;
    --glow-intensity: 0.4;
    --terminal-bg: #1a1a1a;
    --terminal-text: #00ff00;
    --cursor-glow: 0 0 8px rgba(0, 255, 0, 0.6);
    --border-glow: 0 0 15px rgba(0, 255, 0, 0.2);
    --subtle-glow: 0 0 3px rgba(0, 255, 0, 0.3);
  }

  .terminal-container {
    background: var(--terminal-bg);
    border-radius: 12px;
    box-shadow: 
      0 15px 40px rgba(0, 0, 0, 0.9),
      inset 0 0 0 2px rgba(0, 255, 0, 0.3),
      inset 0 0 20px rgba(0, 255, 0, 0.05),
      var(--border-glow);
    max-width: 1100px;
    width: 1100px;
    height: 90vh;
    height: 90dvh;
    max-height: 90vh;
    max-height: 90dvh;
    margin: 0 auto;
    font-family: 'Fira Code', 'Monaco', 'Menlo', monospace;
    overflow: hidden;
    position: relative;
    contain: layout style paint;
    animation: terminalGlow 6s ease-in-out infinite alternate;
    /* Subtle CRT screen curvature */
    transform: perspective(1000px) rotateX(0.5deg);
    /* CRT-style border */
    border: 1px solid rgba(0, 255, 0, 0.1);
    display: flex;
    flex-direction: column;
  }

  .terminal-header {
    background: #2d2d2d;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #444;
  }

  .terminal-controls {
    display: flex;
    gap: 8px;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .close { background: #ff5f57; }
  .minimize { background: #ffbd2e; }
  .maximize { background: #28ca42; }

  .terminal-title {
    color: #999;
    font-size: 14px;
    margin-left: auto;
    margin-right: auto;
  }

  .terminal-body {
    background: 
      radial-gradient(ellipse at center, rgba(0, 20, 0, 0.1) 0%, #000 70%),
      linear-gradient(0deg, transparent 50%, rgba(0, 255, 0, 0.01) 50%);
    background-size: 100% 100%, 100% 4px;
    color: var(--terminal-text);
    padding: 20px;
    flex: 1;
    font-size: 14px;
    line-height: 1.5;
    overflow-y: auto;
    box-sizing: border-box;
    position: relative;
    /* Subtle phosphor glow effect */
    text-shadow: 
      0 0 2px currentColor,
      0 0 4px rgba(0, 255, 0, 0.3);
    /* Very subtle screen flicker */
    animation: subtleFlicker 8s ease-in-out infinite alternate;
  }
  
  /* Moving scanline effect */
  .terminal-body::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent 0%, 
      rgba(0, 255, 0, 0.1) 20%, 
      rgba(0, 255, 0, 0.3) 50%, 
      rgba(0, 255, 0, 0.1) 80%, 
      transparent 100%);
    opacity: 0.7;
    animation: scanline 8s linear infinite;
    pointer-events: none;
    z-index: 1000;
  }

  .terminal-content {
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .terminal-line {
    margin-bottom: 8px;
    display: flex;
    align-items: center;
  }

  .terminal-prompt {
    color: var(--terminal-text);
    font-weight: bold;
    margin-right: 8px;
    flex-shrink: 0;
    text-shadow: var(--subtle-glow);
    animation: promptPulse 4s ease-in-out infinite alternate;
  }

  .terminal-command {
    color: #fff;
  }

  .terminal-input {
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-family: inherit;
    font-size: inherit;
    flex: 1;
    padding: 0;
    margin: 0;
  }

  .terminal-input::placeholder {
    color: #666;
  }

  .terminal-output {
    padding: 12px;
    margin-bottom: 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    border-left: 3px solid #4d4d4d;
  }

  .welcome-message {
    color: #00ff00;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .name {
    color: #fff;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .title {
    color: #ffd700;
    font-size: 16px;
    margin-bottom: 12px;
  }

  .bio {
    color: #ccc;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .contact-info {
    margin-top: 16px;
    padding: 12px;
    background: rgba(0, 255, 0, 0.05);
    border-left: 3px solid #00ff00;
    border-radius: 4px;
  }

  .contact-label {
    color: #00ff00;
    font-weight: bold;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .contact-email {
    color: #ffd700;
    font-family: monospace;
    font-size: 14px;
    background: rgba(255, 215, 0, 0.1);
    padding: 4px 8px;
    border-radius: 4px;
    display: inline-block;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .contact-email:hover {
    background: rgba(255, 215, 0, 0.2);
    color: #fff;
    text-decoration: underline;
    transform: translateY(-1px);
  }

  .command-list {
    margin-bottom: 16px;
  }

  .command-header {
    color: #0c8;
    font-weight: bold;
    margin-bottom: 12px;
    font-size: 1.1em;
  }

  .command-item {
    margin-bottom: 12px;
    padding: 6px;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .command-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .command-details {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .command-name {
    color: #f80;
    cursor: pointer;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(255, 136, 0, 0.1);
    transition: all 0.3s ease;
    text-shadow: 0 0 5px currentColor;
    border: 1px solid rgba(255, 136, 0, 0.3);
  }

  .command-name:hover {
    background: rgba(255, 136, 0, 0.2);
    box-shadow: 
      0 0 10px rgba(255, 136, 0, 0.5),
      inset 0 0 5px rgba(255, 136, 0, 0.2);
    transform: translateY(-1px);
    text-shadow: 
      0 0 8px currentColor,
      0 0 15px currentColor;
  }

  .command-description {
    color: #ccc;
  }
  
  .command-usage {
    color: #999;
    font-size: 0.9em;
    margin-left: 20px;
  }
  
  .command-usage code {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: monospace;
    color: #0c8;
  }
  
  .help-container {
    font-family: monospace;
    padding: 5px 0;
  }
  
  .help-title {
    color: #0f0;
    text-align: center;
    margin-bottom: 15px;
    margin-top: 5px;
    font-weight: bold;
    font-size: 1.1em;
    border-bottom: 1px solid #0f0;
    padding-bottom: 8px;
  }
  
  .help-section {
    margin-bottom: 20px;
    padding-bottom: 15px;
    padding-left: 10px;
  }
  
  .help-section:last-of-type {
    margin-bottom: 10px;
  }
  
  .help-header {
    color: #0f0;
    font-weight: bold;
    margin-bottom: 10px;
    font-size: 1em;
    padding-left: 5px;
  }
  
  .help-command {
    margin: 5px 0;
    padding-left: 15px;
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  
  .command-icon {
    color: #0f0;
    margin-right: 8px;
    font-size: 0.9em;
  }
  
  .command-name {
    color: #0f0;
    cursor: pointer;
    font-weight: bold;
    display: inline-block;
    min-width: 80px;
    margin-right: 5px;
  }
  
  .command-name:hover {
    text-decoration: underline;
  }
  
  .command-separator {
    color: #0f0;
    margin-right: 5px;
  }
  
  .command-desc {
    color: #ccc;
  }
  
  .command-url {
    color: #888;
    font-style: italic;
  }

  .links-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .terminal-link {
    display: flex;
    align-items: center;
    color: #00ff00;
    text-decoration: none;
    padding: 8px 12px;
    border: 1px solid #333;
    border-radius: 4px;
    transition: all 0.3s ease;
    background: rgba(0, 255, 0, 0.05);
  }

  .terminal-link:hover {
    background: rgba(0, 255, 0, 0.1);
    border-color: #00ff00;
    transform: translateX(4px);
  }

  .link-command {
    color: #ffd700;
    font-weight: bold;
    width: 100px;
  }

  .link-arrow {
    color: #00ff00;
    margin: 0 12px;
  }

  .link-label {
    color: #fff;
  }

  .interactive-line {
    margin-top: 32px;
    padding: 8px 0;
  }

  .terminal-cursor {
    color: var(--terminal-text);
    animation: cursorBlink 1s infinite, cursorGlow 3s ease-in-out infinite alternate;
    margin-left: 4px;
    text-shadow: var(--cursor-glow);
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  /* Enhanced glow animations */
  @keyframes terminalGlow {
    0% {
      box-shadow: 
        0 15px 40px rgba(0, 0, 0, 0.9),
        inset 0 0 0 2px rgba(0, 255, 0, 0.2),
        inset 0 0 20px rgba(0, 255, 0, 0.05),
        0 0 15px rgba(0, 255, 0, 0.15);
    }
    100% {
      box-shadow: 
        0 15px 40px rgba(0, 0, 0, 0.9),
        inset 0 0 0 2px rgba(0, 255, 0, 0.3),
        inset 0 0 20px rgba(0, 255, 0, 0.08),
        0 0 20px rgba(0, 255, 0, 0.25);
    }
  }
  
  @keyframes cursorBlink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  @keyframes cursorGlow {
    0% {
      text-shadow: 
        0 0 5px rgba(0, 255, 0, 0.5),
        0 0 8px rgba(0, 255, 0, 0.3);
    }
    100% {
      text-shadow: 
        0 0 8px rgba(0, 255, 0, 0.7),
        0 0 12px rgba(0, 255, 0, 0.4);
    }
  }
  
  @keyframes promptPulse {
    0% {
      text-shadow: 
        0 0 2px currentColor,
        0 0 4px rgba(0, 255, 0, 0.2);
    }
    100% {
      text-shadow: 
        0 0 4px currentColor,
        0 0 8px rgba(0, 255, 0, 0.3);
    }
  }
  
  @keyframes subtleFlicker {
    0%, 98% {
      opacity: 1;
    }
    99% {
      opacity: 0.98;
    }
    100% {
      opacity: 1;
    }
  }
  
  @keyframes profileGlow {
    0% {
      box-shadow: 
        0 0 15px rgba(0, 255, 0, 0.4),
        0 0 30px rgba(0, 255, 0, 0.2),
        inset 0 0 10px rgba(0, 255, 0, 0.1);
    }
    100% {
      box-shadow: 
        0 0 25px rgba(0, 255, 0, 0.6),
        0 0 50px rgba(0, 255, 0, 0.3),
        inset 0 0 15px rgba(0, 255, 0, 0.15);
    }
  }
  
  @keyframes scanline {
    0% {
      top: -2px;
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  .typing-animation {
    overflow: hidden;
    border-right: 2px solid #00ff00;
    white-space: nowrap;
    animation: typing 2s steps(6, end), blink-caret 0.75s step-end infinite;
  }

  @keyframes typing {
    from { width: 0; }
    to { width: 100%; }
  }

  @keyframes blink-caret {
    from, to { border-color: transparent; }
    50% { border-color: #00ff00; }
  }

  .footer-text {
    color: #666;
    font-size: 12px;
    margin-top: 32px;
    text-align: center;
  }


  .error-message {
    color: #ff6b6b;
    margin: 8px 0;
  }

  .success-message {
    color: #00ff00;
    margin: 8px 0;
  }

  .terminal-url-link {
    color: #00bfff;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .terminal-url-link:hover {
    color: #66d9ff;
    text-decoration: underline;
  }

  .profile-picture {
    max-width: 150px;
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    margin: 0 auto 20px;
    border: 2px solid var(--glow-color);
    box-shadow: 
      0 0 10px rgba(0, 255, 0, 0.3),
      0 0 20px rgba(0, 255, 0, 0.1),
      inset 0 0 5px rgba(0, 255, 0, 0.05);
    transition: all 0.3s ease;
    animation: profileGlow 5s ease-in-out infinite alternate;
  }

  .profile-picture:hover {
    transform: scale(1.03) rotate(1deg);
    box-shadow: 
      0 0 15px rgba(0, 255, 0, 0.4),
      0 0 30px rgba(0, 255, 0, 0.2),
      inset 0 0 8px rgba(0, 255, 0, 0.1);
    animation-play-state: paused;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .terminal-container {
      width: 95vw;
      max-width: 1100px;
      height: 95vh;
      height: 95dvh;
      max-height: 95vh;
      max-height: 95dvh;
    }
  }

  @media (max-width: 968px) {
    .terminal-container {
      width: 95vw;
      max-width: 95vw;
      height: 95vh;
      height: 95dvh;
      max-height: 95vh;
      max-height: 95dvh;
      margin: 0;
      border-radius: 8px;
    }

    .terminal-body {
      padding: 16px;
      font-size: 13px;
    }
  }

  @media (max-width: 768px) {
    .command-item {
      flex-direction: column;
      gap: 4px;
    }

    .command-name {
      width: auto;
    }

    .terminal-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .link-command {
      width: auto;
    }

    .link-arrow {
      margin: 0;
    }

    .profile-picture {
      max-width: 120px;
      width: 120px;
      height: 120px;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .typing-animation {
      animation: none;
      border-right: none;
    }
    
    .terminal-cursor {
      animation: none;
      text-shadow: var(--cursor-glow);
    }
    
    .terminal-link {
      transition: none;
    }
    
    .terminal-container {
      animation: none;
    }
    
    .terminal-prompt {
      animation: none;
    }
    
    .profile-picture {
      animation: none;
    }
    
    .terminal-body::before {
      animation: none;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .terminal-container {
      border: 2px solid #fff;
    }
    
    .terminal-link {
      border-color: #fff;
    }
  }
</style>

<script>
  // Import profile data from JSON file
  const profileDataElement = document.getElementById('profile-data');
  const profileData = profileDataElement ? JSON.parse(profileDataElement.textContent || '{}') : {};

  // Command history
  let commandHistory = [];
  let historyIndex = -1;

  // Get terminal elements
  const terminalInput = document.getElementById('terminal-input');
  const terminalContent = document.getElementById('terminal-content');
  const inputLine = document.getElementById('input-line');
  
  // Store original welcome content for restoration after clear
  let originalWelcomeContent: Element[] = [];
  
  // Store original content when page loads
  function storeOriginalContent() {
    const children = Array.from(terminalContent.children);
    originalWelcomeContent = children.filter(child => 
      child.id !== 'input-line' && 
      !child.classList.contains('footer-text')
    ).map(element => element.cloneNode(true) as Element);
  }

  // Focus input when clicking anywhere in terminal (but not on page load)
  // Removed auto-focus on page load to prevent unwanted scrolling

  document.addEventListener('click', (e) => {
    if (e.target.closest('.terminal-container')) {
      terminalInput?.focus();
    }
  });
  
  // Store original content when page loads
  document.addEventListener('DOMContentLoaded', () => {
    // Small delay to ensure all content is rendered
    setTimeout(() => {
      storeOriginalContent();
    }, 100);
  });

  // Handle command input
  terminalInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const command = terminalInput.value.trim().toLowerCase();
      if (command) {
        executeCommand(command);
        commandHistory.unshift(command);
        historyIndex = -1;
      }
      terminalInput.value = '';
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (historyIndex < commandHistory.length - 1) {
        historyIndex++;
        terminalInput.value = commandHistory[historyIndex];
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIndex > 0) {
        historyIndex--;
        terminalInput.value = commandHistory[historyIndex];
      } else if (historyIndex === 0) {
        historyIndex = -1;
        terminalInput.value = '';
      }
    }
  });

  // Execute commands
  function executeCommand(command: string) {
    // Add command to terminal
    addToTerminal(`<div class="terminal-line">
      <span class="terminal-prompt">${profileData.prompt}</span>
      <span class="terminal-command">${command}</span>
    </div>`);

    // Process command
    switch (command) {
      case 'help':
        showHelp();
        break;
      case 'about':
        showAbout();
        break;
      case 'whoami':
        showWhoami();
        break;
      case 'skills':
        showSkills();
        break;
      case 'clear':
        clearTerminal();
        return;
      case 'github':
      case 'linkedin':
      case 'resume':
      case 'til':
      case 'devtools':
      case 'instagram':
        openLink(command);
        break;
      default:
        showError(command);
    }

    scrollToBottom();
  }

  function addToTerminal(html: string) {
    const div = document.createElement('div');
    div.innerHTML = html;
    inputLine.parentNode?.insertBefore(div.firstElementChild, inputLine);
  }

  function showHelp() {
    // Create social links HTML dynamically
    const socialLinksHTML = profileData.social_links ? profileData.social_links.map((link: { command: string, label: string, url: string }) => {
      return `<div class="help-command"><span class="command-icon">→</span><span class="command-name">${link.command}</span><span class="command-separator">:</span> <span class="command-desc">Open ${link.label}</span> <span class="command-url">(${link.url})</span></div>`;
    }).join('') : '';

    const helpText = `
      <div class="terminal-output help-container">
        <div class="help-title">TERMINAL HELP</div>
        
        <div class="help-section">
          <div class="help-header">⚡ Information Commands</div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">about</span><span class="command-separator">:</span> <span class="command-desc">Display detailed information about me</span></div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">whoami</span><span class="command-separator">:</span> <span class="command-desc">Display user information</span></div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">skills</span><span class="command-separator">:</span> <span class="command-desc">Show my technical skills</span></div>
        </div>
        
        <div class="help-section">
          <div class="help-header">🔗 External Links</div>
          ${socialLinksHTML}
        </div>
        
        <div class="help-section">
          <div class="help-header">⌨️ Terminal Controls</div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">clear</span><span class="command-separator">:</span> <span class="command-desc">Clear terminal and restore welcome state</span></div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">help</span><span class="command-separator">:</span> <span class="command-desc">Display this help menu</span></div>
        </div>
        
        <div class="help-section">
          <div class="help-header">🔤 Keyboard Shortcuts</div>
          <div class="help-command"><span class="command-icon">→</span><span>↑/↓</span><span class="command-separator">:</span> <span class="command-desc">Navigate command history</span></div>
          <div class="help-command"><span class="command-icon">→</span><span>Tab</span><span class="command-separator">:</span> <span class="command-desc">Enable keyboard navigation</span></div>
        </div>
      </div>`;

    addToTerminal(helpText);
  }

  function showAbout() {
    const aboutText = `
      <div class="terminal-output">
        <div class="name">${profileData.name}</div>
        <div class="title">${profileData.title}</div>
        <div class="bio">${profileData.bio}</div>
        <div style="margin-top: 16px; color: #ccc;">
          ${profileData.about_extended}
        </div>
      </div>
    `;
    addToTerminal(aboutText);
  }

  function showWhoami() {
    const whoamiText = `
      <div class="terminal-output">
        <div class="success-message">User: ${profileData.name}</div>
        <div style="color: #ccc;">Role: ${profileData.title}</div>
        <div style="color: #ccc;">Status: ${profileData.whoami_info.status}</div>
        <div style="color: #ccc;">Location: ${profileData.whoami_info.location}</div>
      </div>
    `;
    addToTerminal(whoamiText);
  }

  function showSkills() {
    const skillsText = `
      <div class="terminal-output">
        <div class="command-header">Technical Skills:</div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin-top: 12px;">
          ${profileData.skills.map((skill: string) => `
            <div style="color: #ffd700; padding: 4px 8px; background: rgba(255, 215, 0, 0.1); border-radius: 4px;">
              ${skill}
            </div>
          `).join('')}
        </div>
      </div>
    `;
    addToTerminal(skillsText);
  }

  function openLink(command: string) {
    const link = profileData.social_links.find((l: { command: string }) => l.command === command);
    if (link) {
      addToTerminal(`
        <div class="terminal-output">
          <div class="success-message">Opening ${link.label}...</div>
          <div style="color: #ccc; margin-top: 8px;">Please go to <a href="${link.url}" target="_blank" class="terminal-url-link">${link.url}</a> if it doesn't open automatically.</div>
        </div>
      `);
      setTimeout(() => {
        window.open(link.url, '_blank');
      }, 500);
    }
  }


  function showError(command: string) {
    addToTerminal(`
      <div class="terminal-output">
        <div class="error-message">Command not found: ${command}</div>
        <div style="color: #ccc; margin-top: 8px;">Type 'help' to see available commands.</div>
      </div>
    `);
  }

  function clearTerminal() {
    // Show clearing message first
    addToTerminal(`
      <div class="terminal-output">
        <div class="success-message">Clearing terminal and restoring welcome state...</div>
      </div>
    `);
    
    // Small delay for user feedback, then clear and restore
    setTimeout(() => {
      // Remove all content except the input line and footer
      const children = Array.from(terminalContent.children);
      children.forEach(child => {
        if (child.id !== 'input-line' && !child.classList.contains('footer-text')) {
          child.remove();
        }
      });
      
      // Restore the original welcome state
      restoreWelcomeState();
    }, 300);
  }
  
  function restoreWelcomeState() {
    // Restore the original welcome content using cloned elements
    // This preserves the exact CSS scoping and styling from server-rendered content
    const inputLineElement = document.getElementById('input-line');
    const parent = inputLineElement?.parentNode;
    
    if (parent && inputLineElement && originalWelcomeContent.length > 0) {
      // Insert each cloned element before the input line
      originalWelcomeContent.forEach(element => {
        const clonedElement = element.cloneNode(true) as Element;
        parent.insertBefore(clonedElement, inputLineElement);
      });
      
      // Re-enable click-to-copy functionality for command names
      setTimeout(() => {
        setupClickToCopy();
      }, 100);
    }
    
    // Scroll to bottom after restoring content
    setTimeout(scrollToBottom, 200);
  }

  function scrollToBottom() {
    // Only scroll to bottom if user is already near the bottom
    const isNearBottom = terminalContent.scrollTop + terminalContent.clientHeight >= terminalContent.scrollHeight - 100;
    if (isNearBottom) {
      terminalContent.scrollTop = terminalContent.scrollHeight;
    }
  }

  // Add keyboard navigation for existing command names
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      const links = document.querySelectorAll('.terminal-link');
      links.forEach(link => {
        link.setAttribute('tabindex', '0');
      });
    }
  });

  // Add click-to-copy functionality for commands (initial load)
  function setupClickToCopy() {
    document.querySelectorAll('.command-name').forEach((cmd: Element) => {
      cmd.addEventListener('click', () => {
        const command = cmd.textContent;
        if (command && terminalInput) {
          terminalInput.value = command;
          terminalInput.focus();
        }
      });
    });
  }
  
  // Setup click-to-copy after DOM loads
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      setupClickToCopy();
    }, 200);
  });
</script>