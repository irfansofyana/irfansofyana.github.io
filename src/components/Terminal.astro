---
// Import profile data from JSON file
import profileData from '../data/profile.json';

// Create a profile object from the imported data
const profile = profileData;

// Use the base path from the config
import baseConfig from '../../astro.config.mjs';

// Construct the full path for the profile picture
let profilePicturePath = profile.profile_picture;
if (baseConfig.base !== '/') {
  profilePicturePath = `${baseConfig.base}/${profile.profile_picture}`;
}
---

<script id="profile-data" type="application/json" set:html={JSON.stringify(profile)}></script>

<div class="terminal-container">
  <div class="terminal-header">
    <div class="terminal-controls">
      <div class="control close"></div>
      <div class="control minimize"></div>
      <div class="control maximize"></div>
    </div>
    <div class="terminal-title">terminal</div>
  </div>

  <div class="terminal-body">
    <div class="terminal-content" id="terminal-content">
      <!-- Welcome Message -->
      <div class="terminal-line">
        <span class="terminal-prompt">{profile.prompt}</span>
        <span class="terminal-command typing-animation">whoami</span>
      </div>

      <div class="section-rule">┌─ WHOAMI ────────────────────────────────────────────────────┐</div>

      <div class="terminal-output">
        <img
          src={profilePicturePath}
          alt="Profile Picture"
          class="profile-picture"
          onerror="this.style.display='none'; console.log('Profile picture failed to load:', this.src);"
          onload="console.log('Profile picture loaded successfully:', this.src);"
        />
        {profile.welcome_message && profile.welcome_message.trim() !== '' && (
          <div class="welcome-message">{profile.welcome_message}</div>
        )}
        <div class="name">{profile.name}</div>
        <div class="title">{profile.title}</div>
        <div class="bio">{profile.bio}</div>
        {profile.contact && profile.contact.show_in_welcome && (
          <div class="contact-info">
            <div class="contact-label">CONTACT</div>
            <a href={`mailto:${profile.contact.email}`} class="contact-email">{profile.contact.email}</a>
          </div>
        )}
      </div>

      <!-- Available Commands -->
      <div class="terminal-line">
        <span class="terminal-prompt">{profile.prompt}</span>
        <span class="terminal-command">help</span>
      </div>

      <div class="section-rule">┌─ HELP ──────────────────────────────────────────────────────┐</div>

      <div class="terminal-output">
        <div class="command-list">
          {profile.social_links.map((link) => (
            <div class="command-item">
              <span class="command-name">{link.command}</span>
              <span class="command-description">{link.description}</span>
            </div>
          ))}
          <div class="command-item">
            <span class="command-name">about</span>
            <span class="command-description">Display detailed information about me</span>
          </div>
          <div class="command-item">
            <span class="command-name">skills</span>
            <span class="command-description">Show my technical skills</span>
          </div>
          <div class="command-item">
            <span class="command-name">clear</span>
            <span class="command-description">Clear terminal and restore welcome state</span>
          </div>
          <div class="command-item">
            <span class="command-name">whoami</span>
            <span class="command-description">Display user information</span>
          </div>
        </div>
      </div>

      <!-- Interactive Prompt -->
      <div class="terminal-line interactive-line" id="input-line">
        <span class="terminal-prompt">{profile.prompt}</span>
        <input
          type="text"
          id="terminal-input"
          class="terminal-input"
          autocomplete="off"
          spellcheck="false"
          placeholder="Type a command..."
        />
        <span class="terminal-cursor">_</span>
      </div>

      <div class="footer-text">{profile.footer_text}</div>
    </div>
  </div>
</div>

<style>
  .terminal-container {
    background: var(--bg-terminal);
    border-radius: 12px;
    box-shadow:
      0 15px 40px rgba(0, 0, 0, 0.9),
      inset 0 0 0 2px var(--phosphor-soft),
      inset 0 0 20px rgba(54, 255, 122, 0.05),
      0 0 18px var(--phosphor-soft);
    max-width: 1100px;
    width: 1100px;
    height: 90vh;
    height: 90dvh;
    max-height: 90vh;
    max-height: 90dvh;
    margin: 0 auto;
    font-family: var(--font-mono);
    overflow: hidden;
    position: relative;
    contain: layout style paint;
    transform: perspective(1000px) rotateX(0.5deg);
    border: 1px solid rgba(54, 255, 122, 0.1);
    display: flex;
    flex-direction: column;
  }

  .terminal-header {
    background: #1c1f1c;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #2a2e2a;
  }

  .terminal-controls {
    display: flex;
    gap: 8px;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .close { background: #ff5f57; }
  .minimize { background: #ffbd2e; }
  .maximize { background: #28ca42; }

  .terminal-title {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    letter-spacing: var(--tr-wide);
    margin-left: auto;
    margin-right: auto;
  }

  .terminal-body {
    background:
      radial-gradient(ellipse at center, rgba(0, 30, 10, 0.18) 0%, #000 75%),
      linear-gradient(0deg, transparent 50%, rgba(54, 255, 122, 0.012) 50%);
    background-size: 100% 100%, 100% 4px;
    color: var(--phosphor);
    padding: var(--sp-5);
    flex: 1;
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    overflow-y: auto;
    box-sizing: border-box;
    position: relative;
    animation: subtleFlicker 8s ease-in-out infinite alternate;
  }

  /* Moving scanline */
  .terminal-body::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg,
      transparent 0%,
      rgba(54, 255, 122, 0.1) 20%,
      rgba(54, 255, 122, 0.3) 50%,
      rgba(54, 255, 122, 0.1) 80%,
      transparent 100%);
    opacity: 0.4;
    animation: scanline 12s linear infinite;
    pointer-events: none;
    z-index: 2;
  }

  .terminal-content {
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .terminal-line {
    margin-bottom: var(--sp-2);
    display: flex;
    align-items: center;
  }

  .terminal-prompt {
    font-family: var(--font-display);
    font-weight: var(--fw-regular);
    color: var(--phosphor);
    text-shadow: var(--glow-sm);
    margin-right: var(--sp-2);
    flex-shrink: 0;
  }

  .terminal-command {
    color: var(--text-primary);
    font-weight: var(--fw-medium);
  }

  .terminal-input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    font-family: inherit;
    font-size: inherit;
    font-weight: var(--fw-medium);
    caret-color: var(--phosphor);
    flex: 1;
    padding: 0;
    margin: 0;
  }

  .terminal-input::placeholder {
    color: var(--text-muted);
  }

  .terminal-output {
    padding: var(--sp-4);
    margin-bottom: var(--sp-4);
    background: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
    border-left: 2px solid rgba(54, 255, 122, 0.2);
  }

  /* ASCII section rule */
  .section-rule {
    font-family: var(--font-mono);
    font-size: var(--fs-base);
    color: var(--phosphor);
    text-shadow: var(--glow-sm);
    letter-spacing: 0;
    white-space: pre;
    overflow: hidden;
    margin: var(--sp-5) 0 var(--sp-3);
    user-select: none;
    opacity: 0.85;
  }

  .welcome-message {
    color: var(--phosphor);
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
    text-shadow: var(--glow-sm);
    margin-bottom: var(--sp-2);
  }

  .name {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-black);
    letter-spacing: var(--tr-display);
    line-height: var(--lh-tight);
    color: var(--text-primary);
    margin: var(--sp-3) 0 var(--sp-2);
  }

  .title {
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--accent-gold);
    opacity: 0.85;
    margin-bottom: var(--sp-4);
  }

  .bio {
    font-family: var(--font-mono);
    font-size: var(--fs-prose);
    line-height: var(--lh-prose);
    font-weight: var(--fw-regular);
    color: var(--text-primary);
    max-width: 64ch;
    margin: 0 0 var(--sp-4);
  }

  .bio::first-letter {
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: 2.4em;
    float: left;
    line-height: 0.9;
    margin: 0.1em 0.18em 0 0;
    color: var(--phosphor);
    text-shadow: 0 0 8px var(--phosphor-dim);
  }

  .about-extended {
    font-family: var(--font-mono);
    font-size: var(--fs-prose);
    line-height: var(--lh-prose);
    color: var(--text-secondary);
    max-width: 64ch;
    margin-top: var(--sp-4);
  }

  .contact-info {
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    background: rgba(54, 255, 122, 0.04);
    border-left: 2px solid var(--phosphor);
    border-radius: 4px;
  }

  .contact-label {
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--phosphor);
    text-shadow: var(--glow-sm);
    margin-bottom: var(--sp-2);
  }

  .contact-email {
    color: var(--text-primary);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    background: rgba(255, 217, 102, 0.06);
    border: 1px solid rgba(255, 217, 102, 0.3);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-block;
    text-decoration: none;
    transition: all 240ms cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }

  .contact-email:hover {
    background: rgba(255, 217, 102, 0.14);
    border-color: var(--accent-gold);
    color: var(--accent-gold);
    transform: translateY(-1px);
  }

  .command-list {
    margin-bottom: var(--sp-4);
  }

  .command-header {
    font-size: var(--fs-md);
    font-weight: var(--fw-semi);
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--phosphor);
    text-shadow: var(--glow-sm);
    margin-bottom: var(--sp-3);
  }

  .command-item {
    margin-bottom: var(--sp-2);
    padding: var(--sp-1) var(--sp-3);
    border-left: 2px solid transparent;
    border-radius: 2px;
    transition: all 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .command-item:hover {
    background: rgba(255, 180, 84, 0.05);
    border-left-color: var(--accent-amber);
    padding-left: calc(var(--sp-3) + 4px);
  }

  .command-name {
    color: var(--accent-amber);
    cursor: pointer;
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-tight);
    padding: 2px 6px;
    border-radius: 3px;
    background: rgba(255, 180, 84, 0.08);
    transition: all 240ms cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid rgba(255, 180, 84, 0.2);
    margin-right: var(--sp-2);
  }

  .command-name:hover {
    background: rgba(255, 180, 84, 0.18);
    border-color: var(--accent-amber);
    box-shadow: 0 0 8px rgba(255, 180, 84, 0.35);
  }

  .command-description {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    font-weight: var(--fw-regular);
  }

  /* Help command output */
  .help-container {
    padding: 0;
  }

  .help-title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: var(--fw-black);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--phosphor);
    text-shadow: 0 0 8px var(--phosphor-dim);
    text-align: left;
    border: none;
    padding: 0;
    margin: 0 0 var(--sp-5);
  }

  .help-section {
    margin-bottom: var(--sp-5);
  }

  .help-section:last-of-type {
    margin-bottom: var(--sp-2);
  }

  .help-header {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--phosphor);
    text-shadow: var(--glow-sm);
    margin: 0 0 var(--sp-3);
  }

  .help-header::before {
    content: "▸ ";
    color: var(--phosphor);
  }

  .help-command {
    margin: var(--sp-1) 0;
    padding-left: var(--sp-4);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
  }

  .command-icon {
    color: var(--phosphor);
    opacity: 0.6;
  }

  .command-separator {
    color: var(--text-muted);
  }

  .command-desc {
    color: var(--text-secondary);
  }

  .command-url {
    color: #889988;
    font-style: italic;
    font-size: var(--fs-micro);
  }

  /* Skills */
  .skills-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-2) var(--sp-5);
    margin-top: var(--sp-3);
  }

  .skill-row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    border-bottom: 1px dashed rgba(54, 255, 122, 0.15);
    padding-bottom: var(--sp-1);
  }

  .skill-num {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: var(--fw-regular);
    color: var(--text-muted);
    letter-spacing: var(--tr-wide);
  }

  .skill-name {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  /* Whoami output */
  .whoami-row {
    font-size: var(--fs-base);
    color: var(--text-secondary);
    margin: var(--sp-1) 0;
  }

  .whoami-label {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    display: inline-block;
    min-width: 80px;
    margin-right: var(--sp-3);
  }

  .interactive-line {
    margin-top: var(--sp-5);
    padding: var(--sp-2) 0;
  }

  .terminal-cursor {
    color: var(--phosphor);
    animation: cursorBlink 1s infinite;
    margin-left: 4px;
    text-shadow: var(--cursor-glow);
  }

  @keyframes cursorBlink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @keyframes subtleFlicker {
    0%, 98% { opacity: 1; }
    99% { opacity: 0.98; }
    100% { opacity: 1; }
  }

  @keyframes profileGlow {
    0% {
      box-shadow:
        0 0 15px rgba(54, 255, 122, 0.4),
        0 0 30px rgba(54, 255, 122, 0.2),
        inset 0 0 10px rgba(54, 255, 122, 0.1);
    }
    100% {
      box-shadow:
        0 0 25px rgba(54, 255, 122, 0.6),
        0 0 50px rgba(54, 255, 122, 0.3),
        inset 0 0 15px rgba(54, 255, 122, 0.15);
    }
  }

  @keyframes scanline {
    0%   { top: -2px; opacity: 1; }
    50%  { opacity: 0.6; }
    100% { top: 100%; opacity: 0; }
  }

  .typing-animation {
    overflow: hidden;
    border-right: 2px solid var(--phosphor);
    white-space: nowrap;
    animation: typing 2s steps(6, end), blink-caret 0.75s step-end infinite;
  }

  @keyframes typing {
    from { width: 0; }
    to   { width: 100%; }
  }

  @keyframes blink-caret {
    from, to { border-color: transparent; }
    50%      { border-color: var(--phosphor); }
  }

  .footer-text {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    text-align: center;
    margin-top: var(--sp-6);
  }

  .error-message {
    color: var(--accent-error);
    font-weight: var(--fw-medium);
    margin: var(--sp-2) 0;
  }

  .success-message {
    color: var(--phosphor);
    font-weight: var(--fw-medium);
    text-shadow: var(--glow-sm);
    margin: var(--sp-2) 0;
  }

  .terminal-url-link {
    color: var(--accent-cyan);
    text-decoration: underline;
    transition: color 200ms ease;
  }

  .terminal-url-link:hover {
    color: #a0e4ff;
  }

  .profile-picture {
    max-width: 180px;
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    margin: 0 auto var(--sp-5);
    border: 2px solid var(--phosphor);
    box-shadow:
      0 0 10px rgba(54, 255, 122, 0.3),
      0 0 20px rgba(54, 255, 122, 0.1),
      inset 0 0 5px rgba(54, 255, 122, 0.05);
    transition: transform 240ms cubic-bezier(0.4, 0, 0.2, 1);
    animation: profileGlow 5s ease-in-out infinite alternate;
  }

  .profile-picture:hover {
    transform: scale(1.03);
    animation-play-state: paused;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .terminal-container {
      width: 95vw;
      max-width: 1100px;
      height: 95vh;
      height: 95dvh;
      max-height: 95vh;
      max-height: 95dvh;
    }
  }

  @media (max-width: 968px) {
    .terminal-container {
      width: 95vw;
      max-width: 95vw;
      height: 95vh;
      height: 95dvh;
      max-height: 95vh;
      max-height: 95dvh;
      margin: 0;
      border-radius: 8px;
      transform: none;
    }

    .terminal-body {
      padding: var(--sp-4);
    }

    .name { font-size: 2.25rem; }
    .section-rule { font-size: var(--fs-sm); }
  }

  @media (max-width: 768px) {
    .name { font-size: 2rem; }
    .command-item {
      flex-direction: column;
      gap: var(--sp-1);
    }
    .profile-picture {
      max-width: 130px;
      width: 130px;
      height: 130px;
    }
    .section-rule {
      font-size: var(--fs-xs, 11px);
    }
    .bio::first-letter {
      font-size: 2em;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .typing-animation { animation: none; border-right: none; }
    .terminal-cursor { animation: none; }
    .terminal-container { animation: none; transform: none; }
    .profile-picture { animation: none; }
    .terminal-body { animation: none; }
    .terminal-body::before { animation: none; }
    .command-item, .command-name, .contact-email, .profile-picture { transition: none; }
  }

  @media (prefers-contrast: high) {
    .terminal-container { border: 2px solid #fff; }
    .command-name { border-color: #fff; }
  }
</style>

<script>
  // Import profile data from JSON file
  const profileDataElement = document.getElementById('profile-data');
  const profileData = profileDataElement ? JSON.parse(profileDataElement.textContent || '{}') : {};

  // Command history
  let commandHistory = [];
  let historyIndex = -1;

  // Get terminal elements
  const terminalInput = document.getElementById('terminal-input');
  const terminalContent = document.getElementById('terminal-content');
  const inputLine = document.getElementById('input-line');

  // Store original welcome content for restoration after clear
  let originalWelcomeContent: Element[] = [];

  function storeOriginalContent() {
    const children = Array.from(terminalContent.children);
    originalWelcomeContent = children.filter(child =>
      child.id !== 'input-line' &&
      !child.classList.contains('footer-text')
    ).map(element => element.cloneNode(true) as Element);
  }

  document.addEventListener('click', (e) => {
    if (e.target.closest('.terminal-container')) {
      terminalInput?.focus();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      storeOriginalContent();
    }, 100);
  });

  terminalInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const command = terminalInput.value.trim().toLowerCase();
      if (command) {
        executeCommand(command);
        commandHistory.unshift(command);
        historyIndex = -1;
      }
      terminalInput.value = '';
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (historyIndex < commandHistory.length - 1) {
        historyIndex++;
        terminalInput.value = commandHistory[historyIndex];
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIndex > 0) {
        historyIndex--;
        terminalInput.value = commandHistory[historyIndex];
      } else if (historyIndex === 0) {
        historyIndex = -1;
        terminalInput.value = '';
      }
    }
  });

  function executeCommand(command: string) {
    addToTerminal(`<div class="terminal-line">
      <span class="terminal-prompt">${profileData.prompt}</span>
      <span class="terminal-command">${command}</span>
    </div>`);

    switch (command) {
      case 'help':
        showHelp();
        break;
      case 'about':
        showAbout();
        break;
      case 'whoami':
        showWhoami();
        break;
      case 'skills':
        showSkills();
        break;
      case 'clear':
        clearTerminal();
        return;
      case 'github':
      case 'linkedin':
      case 'resume':
      case 'til':
      case 'devtools':
      case 'instagram':
        openLink(command);
        break;
      default:
        showError(command);
    }

    scrollToBottom();
  }

  function addToTerminal(html: string) {
    const div = document.createElement('div');
    div.innerHTML = html;
    while (div.firstElementChild) {
      inputLine.parentNode?.insertBefore(div.firstElementChild, inputLine);
    }
  }

  function sectionRule(label: string) {
    const dashCount = Math.max(4, 58 - label.length);
    return `<div class="section-rule">┌─ ${label} ${'─'.repeat(dashCount)}┐</div>`;
  }

  function showHelp() {
    const socialLinksHTML = profileData.social_links ? profileData.social_links.map((link: { command: string, label: string, url: string }) => {
      return `<div class="help-command"><span class="command-icon">→</span><span class="command-name">${link.command}</span><span class="command-separator">·</span><span class="command-desc">Open ${link.label}</span><span class="command-url">${link.url}</span></div>`;
    }).join('') : '';

    const helpText = `
      ${sectionRule('HELP')}
      <div class="terminal-output help-container">
        <div class="help-title">Terminal Help</div>

        <div class="help-section">
          <div class="help-header">Information</div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">about</span><span class="command-separator">·</span><span class="command-desc">Display detailed information about me</span></div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">whoami</span><span class="command-separator">·</span><span class="command-desc">Display user information</span></div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">skills</span><span class="command-separator">·</span><span class="command-desc">Show my technical skills</span></div>
        </div>

        <div class="help-section">
          <div class="help-header">External Links</div>
          ${socialLinksHTML}
        </div>

        <div class="help-section">
          <div class="help-header">Terminal Controls</div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">clear</span><span class="command-separator">·</span><span class="command-desc">Clear terminal and restore welcome state</span></div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">help</span><span class="command-separator">·</span><span class="command-desc">Display this help menu</span></div>
        </div>

        <div class="help-section">
          <div class="help-header">Keyboard Shortcuts</div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">↑/↓</span><span class="command-separator">·</span><span class="command-desc">Navigate command history</span></div>
          <div class="help-command"><span class="command-icon">→</span><span class="command-name">Tab</span><span class="command-separator">·</span><span class="command-desc">Enable keyboard navigation</span></div>
        </div>
      </div>`;

    addToTerminal(helpText);
  }

  function showAbout() {
    const aboutText = `
      ${sectionRule('ABOUT')}
      <div class="terminal-output">
        <div class="name">${profileData.name}</div>
        <div class="title">${profileData.title}</div>
        <div class="bio">${profileData.bio}</div>
        <div class="about-extended">${profileData.about_extended}</div>
      </div>
    `;
    addToTerminal(aboutText);
  }

  function showWhoami() {
    const whoamiText = `
      ${sectionRule('WHOAMI')}
      <div class="terminal-output">
        <div class="success-message">User · ${profileData.name}</div>
        <div class="whoami-row"><span class="whoami-label">Role</span>${profileData.title}</div>
        <div class="whoami-row"><span class="whoami-label">Status</span>${profileData.whoami_info.status}</div>
        <div class="whoami-row"><span class="whoami-label">Location</span>${profileData.whoami_info.location}</div>
      </div>
    `;
    addToTerminal(whoamiText);
  }

  function showSkills() {
    const rows = profileData.skills.map((skill: string, i: number) => {
      const num = String(i + 1).padStart(2, '0');
      return `<div class="skill-row"><span class="skill-num">${num}</span><span class="skill-name">${skill}</span></div>`;
    }).join('');

    const skillsText = `
      ${sectionRule('SKILLS')}
      <div class="terminal-output">
        <div class="command-header">Technical Skills</div>
        <div class="skills-list">${rows}</div>
      </div>
    `;
    addToTerminal(skillsText);
  }

  function openLink(command: string) {
    const link = profileData.social_links.find((l: { command: string }) => l.command === command);
    if (link) {
      addToTerminal(`
        <div class="terminal-output">
          <div class="success-message">Opening ${link.label}...</div>
          <div class="whoami-row" style="margin-top:8px;">Please go to <a href="${link.url}" target="_blank" class="terminal-url-link">${link.url}</a> if it doesn't open automatically.</div>
        </div>
      `);
      setTimeout(() => {
        window.open(link.url, '_blank');
      }, 500);
    }
  }

  function showError(command: string) {
    addToTerminal(`
      <div class="terminal-output">
        <div class="error-message">Command not found · ${command}</div>
        <div class="whoami-row" style="margin-top:8px;">Type <span class="command-name">help</span> to see available commands.</div>
      </div>
    `);
  }

  function clearTerminal() {
    addToTerminal(`
      <div class="terminal-output">
        <div class="success-message">Clearing terminal and restoring welcome state...</div>
      </div>
    `);

    setTimeout(() => {
      const children = Array.from(terminalContent.children);
      children.forEach(child => {
        if (child.id !== 'input-line' && !child.classList.contains('footer-text')) {
          child.remove();
        }
      });

      restoreWelcomeState();
    }, 300);
  }

  function restoreWelcomeState() {
    const inputLineElement = document.getElementById('input-line');
    const parent = inputLineElement?.parentNode;

    if (parent && inputLineElement && originalWelcomeContent.length > 0) {
      originalWelcomeContent.forEach(element => {
        const clonedElement = element.cloneNode(true) as Element;
        parent.insertBefore(clonedElement, inputLineElement);
      });

      setTimeout(() => {
        setupClickToCopy();
      }, 100);
    }

    setTimeout(scrollToBottom, 200);
  }

  function scrollToBottom() {
    const isNearBottom = terminalContent.scrollTop + terminalContent.clientHeight >= terminalContent.scrollHeight - 100;
    if (isNearBottom) {
      terminalContent.scrollTop = terminalContent.scrollHeight;
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      const links = document.querySelectorAll('.terminal-link');
      links.forEach(link => {
        link.setAttribute('tabindex', '0');
      });
    }
  });

  function setupClickToCopy() {
    document.querySelectorAll('.command-name').forEach((cmd: Element) => {
      cmd.addEventListener('click', () => {
        const command = cmd.textContent;
        if (command && terminalInput) {
          terminalInput.value = command;
          terminalInput.focus();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      setupClickToCopy();
    }, 200);
  });
</script>
